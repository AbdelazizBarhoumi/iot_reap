[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/symfony/http-foundation.git
	fetch = +refs/heads/*:refs/remotes/origin/*
	pushurl = git@github.com:symfony/http-foundation.git
[branch "8.1"]
	remote = origin
	merge = refs/heads/8.1
[remote "composer"]
	url = https://github.com/symfony/http-foundation.git
	fetch = +refs/heads/*:refs/remotes/composer/*
