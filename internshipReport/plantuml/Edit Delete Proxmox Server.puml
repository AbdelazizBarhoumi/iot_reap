@startuml
title Use Case: Edit / Delete Proxmox Server - Sequence

actor Administrator as Admin
boundary "Admin Infrastructure Page" as UI
control "Admin\\ProxmoxServerController" as Controller
participant "UpdateProxmoxServerRequest" as UpdateRequest
control "ProxmoxConnection" as Connection
entity "ProxmoxServer" as Server
entity "ProxmoxNode" as Node
entity "VMSession" as Session
entity "NodeCredentialsLog" as AuditLog
database "ApplicationDB" as DB

Admin -> UI : select server and choose edit/delete
UI -> Controller : PATCH or DELETE /admin/proxmox-servers/{id}
activate Controller

note over Controller
Admin middleware already requires an authenticated
administrator. Deletion only affects local records;
the remote Proxmox cluster is not modified.
end note

alt Edit existing Proxmox server
    Controller -> UpdateRequest : validate(authorize + rules)
    activate UpdateRequest
    UpdateRequest --> Controller : validated data
    deactivate UpdateRequest

    Controller -> Controller : detect changed connection fields

    opt host, port, token, or SSL settings changed
        Controller -> Connection : testConnection(host, port, credentials, verifySsl)
        activate Connection
        Connection --> Controller : success
        deactivate Connection
    end

    Controller -> Server : update(validated data)
    activate Server
    Server -> DB : persist updated attributes
    DB --> Server : updated server
    deactivate Server

    Controller -> AuditLog : create(updated entry)
    activate AuditLog
    AuditLog -> DB : insert audit record
    DB --> AuditLog : logged
    deactivate AuditLog

    Controller --> UI : 200 OK + updated server resource

else Delete existing Proxmox server
    Controller -> Node : where(proxmox_server_id = server.id)
    activate Node
    Node --> Controller : matching node ids
    deactivate Node

    Controller -> Session : delete sessions linked to server or node ids
    activate Session
    Session --> Controller : deleted sessions
    deactivate Session

    Controller -> Node : delete(local nodes)
    activate Node
    Node -> DB : remove node records
    DB --> Node : deleted
    deactivate Node

    Controller -> AuditLog : create(deleted entry)
    activate AuditLog
    AuditLog -> DB : insert audit record
    DB --> AuditLog : logged
    deactivate AuditLog

    Controller -> Server : delete()
    activate Server
    Server -> DB : remove server record
    DB --> Server : deleted
    deactivate Server

    Controller --> UI : 200 OK + deletion confirmation
end

deactivate Controller

@enduml